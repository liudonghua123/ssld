{
  "server": {
    "bind": "0.0.0.0",
    "port": 7979,
    "secure_entry": "/",
    "https": false,
    "tls_cert": "",
    "tls_key": ""
  },
  "auth": {
    "username": "admin",
    "password": "change-this-password",
    "api_key": "",
    "session_timeout": 86400,
    "login_lock_threshold": 5,
    "login_lock_minutes": 15,
    "require_auth": false
  },
  "acme": {
    "default_ca": "letsencrypt",
    "default_algorithm": "RSA2048",
    "renew_before_days": 30,
    "dns_propagation_wait": 120,
    "nameservers": ["8.8.8.8:53", "1.1.1.1:53"],
    "ari_enabled": true,
    "contact_email": "ops@example.org",
    "skip_dns_check": false,
    "disable_cname": false
  },
  "scheduler": {
    "enabled": true,
    "tick_seconds": 10
  },
  "webhook": {
    "enabled": true,
    "timeout_seconds": 10,
    "max_attempts": 5,
    "backoff_seconds": 60,
    "signature_header": "X-SSLD-Signature",
    "user_agent": "ssld/1.0"
  },
  "mcp": {
    "enabled": true,
    "path": "/mcp",
    "require_auth": false
  },
  "storage": {
    "data_dir": "data",
    "workflow_log_dir": "data/workflow-logs",
    "max_event_log": 1000,
    "max_delivery_log": 1000
  }
}
